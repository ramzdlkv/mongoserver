const mongoose = require("mongoose")

const adminSchema = new mongoose.Schema({
    name: {
        type: String,
        required: true,
        trim: true
    },

        lastname: {
        type: String,
        required: true,
        trim: true
    },

        age: {
        type: Number,
        required: true,
        trim: true
    },
        city: {
        type: String,
        required: true,
        trim: true
    },

        phone: {
        type: Number,
        required: true,
        trim: true
    }
})

module.exports = mongoose.model("Admin", adminSchema)